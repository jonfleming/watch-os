# Waveshare ESP32-S3 Touch AMOLED 2.06 board-specific sdkconfig overlay.
# Loaded on top of sdkconfig.defaults when WAVESHARE_AMOLED_2_06_BOARD=ON
# (see the SDKCONFIG_DEFAULTS wiring in CMakeLists.txt).
#
# Delete sdkconfig and fullclean when switching boards: ESP-IDF will not
# rewrite flash/console keys that already exist in sdkconfig.

# Restore UART0 after a 1.8 build (USB-Serial-JTAG). The 2.06 USB-C goes
# through a USB-UART bridge; UART0 is the working console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set

# The 2.06 ships with 32 MB of external flash (vs 16 MB on the 1.8).
# QIO is the flash mode Waveshare's examples mandate for this board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
